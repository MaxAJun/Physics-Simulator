const bubbleGeo = new THREE.BufferGeometry();
bubbleGeo.setAttribute('position', new THREE.BufferAttribute(posArr, 3));
bubbleGeo.setAttribute('aColor',   new THREE.BufferAttribute(colArr, 3));
bubbleGeo.setAttribute('aAlpha',   new THREE.BufferAttribute(alphaArr, 1));
bubbleGeo.setIndex(new THREE.BufferAttribute(idxArr, 1));
bubbleGeo.computeBoundingSphere();

const bubbleMesh = new THREE.Mesh(bubbleGeo, bubbleMat);
scene.add(bubbleMesh);

/* ---- Groups for dynamically rebuilt content ---- */
const contourGroup = new THREE.Group();
const arrowGroup   = new THREE.Group();
const axisGroup    = new THREE.Group();
scene.add(contourGroup, arrowGroup, axisGroup);

function clearGroup(g) {
  for (let i = g.children.length - 1; i >= 0; i--) {
    const c = g.children[i];
    g.remove(c);
    c.traverse(o => {
      if (o.geometry) o.geometry.dispose();
      if (o.material) {
        if (Array.isArray(o.material)) o.material.forEach(m => m.dispose());
        else o.material.dispose();
      }
    });
  }
}

/* ==================================================================
   ARROW BUILDER
   ================================================================== */
function createArrow(start, dir, length, colorHex,
                     shaftRadius = 0.025, headRadius = 0.08, headRatio = 0.18) {
  const group = new THREE.Group();

  const d = new THREE.Vector3(dir[0], dir[1], dir[2]);
  if (d.lengthSq() < 1e-18) return group;
  d.normalize();

  const shaftLen = length * (1 - headRatio);
  const headLen  = length * headRatio;

  const mat = new THREE.MeshStandardMaterial({
    color: colorHex, roughness: 0.45, metalness: 0.15
  });

  const shaft = new THREE.Mesh(
    new THREE.CylinderGeometry(shaftRadius, shaftRadius, shaftLen, 12), mat
  );
  shaft.position.y = shaftLen * 0.5;
  group.add(shaft);

  const head = new THREE.Mesh(
    new THREE.ConeGeometry(headRadius, headLen, 16), mat
  );
  head.position.y = shaftLen + headLen * 0.5;
  group.add(head);

  group.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), d);
  group.position.set(start[0], start[1], start[2]);
  return group;
}

/* ==================================================================
   CONTOUR LINES
   ================================================================== */
function rebuildContours(h) {
  clearGroup(contourGroup);
  const mat  = new THREE.LineBasicMaterial({ color: 0x9a9a9a, transparent: true, opacity: 0.55 });
  const mat2 = new THREE.LineBasicMaterial({ color: 0x9a9a9a, transparent: true, opacity: 0.32 });

  /* --- base circle (equator, z = 0) --- */
  {
    const pts = [];
    const phi = [];
    for (let i = 0; i <= 64; i++) phi.push(i / 64 * Math.PI * 2);
    for (const p of phi) pts.push(new THREE.Vector3(Math.cos(p), Math.sin(p), 0));
    contourGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), mat));
  }

  /* --- meridians --- */
  const nMeridians = 8;
  for (let m = 0; m < nMeridians; m++) {
    const phi = 2 * Math.PI * m / nMeridians;
    const pts = [];
    const steps = 30;
    for (let s = 0; s <= steps; s++) {
      const theta = (s / steps) * (Math.PI / 2);
      const st = Math.sin(theta);
      pts.push(new THREE.Vector3(
        st * Math.cos(phi),
        st * Math.sin(phi),
        Math.cos(theta) * h
      ));
    }
    contourGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), mat));
  }

  /* --- latitude circles --- */
  for (const zLevel of [0.25, 0.5, 0.75]) {
    const theta = Math.acos(zLevel);
    const r = Math.sin(theta);
    const pts = [];
    for (let i = 0; i <= 48; i++) {
      const p = i / 48 * Math.PI * 2;
      pts.push(new THREE.Vector3(r * Math.cos(p), r * Math.sin(p), zLevel * h));
    }
    contourGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), mat2));
  }
}

/* ==================================================================
   AXIS TRIPOD
   ================================================================== */
function buildAxes() {
  clearGroup(axisGroup);
  const L = 1.8;
  axisGroup.add(createArrow([0, 0, 0], [1, 0, 0], L, 0xff3030, 0.012, 0.045, 0.14));
  axisGroup.add(createArrow([0, 0, 0], [0, 1, 0], L, 0x30ff40, 0.012, 0.045, 0.14));
  axisGroup.add(createArrow([0, 0, 0], [0, 0, 1], L, 0x4080ff, 0.012, 0.045, 0.14));
}
buildAxes();

/* ==================================================================
   LIGHT ARROWS
   ================================================================== */
let lastArrowKey = '';

function rebuildArrows(theta1Deg, theta2Deg, on1, on2) {
  const key = `${theta1Deg}|${theta2Deg}|${on1}|${on2}`;
  if (key === lastArrowKey) return;
  lastArrowKey = key;

  clearGroup(arrowGroup);

  const th1 = theta1Deg * Math.PI / 180;
  const th2 = theta2Deg * Math.PI / 180;

  const dir1 = [-Math.sin(th1), 0, -Math.cos(th1)];
  const dir2 = [-Math.sin(th2), 0, -Math.cos(th2)];

  if (on1) {
    for (const x0 of [-1.0, -0.5, 0.0, 0.5, 1.0]) {
      arrowGroup.add(createArrow([x0, 0, 1.8], dir1, 0.8, 0xffff00));
    }
  }

  if (on2) {
    for (const x0 of [-1.0, -0.5, 0.0, 0.5, 1.0]) {
      arrowGroup.add(createArrow([x0, 0.6, 1.8], dir2, 0.8, 0xff0000));
    }
  }
}

/* ==================================================================
   MAIN COLOR / GEOMETRY UPDATE
   ================================================================== */
const xyzScratch = new Float32Array(numVerts * 3);

function updateScene() {
  const theta1   = state.theta1;
  const theta2   = state.theta2;
  const scale    = state.scale;
  const h        = state.height;
  const gravity  = state.gravity;
  const defectNm = state.defect;
  const on1      = state.on1;
  const on2      = state.on2;

  const th1 = theta1 * Math.PI / 180;
  const th2 = theta2 * Math.PI / 180;

  const ld1x = Math.sin(th1), ld1y = 0, ld1z = Math.cos(th1);
  const ld2x = Math.sin(th2), ld2y = 0, ld2z = Math.cos(th2);

  const defectAmp = defectNm * 1e-9;
  const h2 = h * h;

  /* ---------- per-vertex loop ---------- */
  for (let j = 0; j < N_V; j++) {
    for (let i = 0; i < N_U; i++) {
      const idx = j * N_U + i;

      const x  = Xb[idx];
      const y  = Yb[idx];
      const zb = Zb[idx];
      const z  = zb * h;

      posArr[idx * 3 + 2] = z;

      /* ---- ellipsoid normal ---- */
      let nx = x;
      let ny = y;
      let nz = (h !== 0) ? z / h2 : z;

      const nl = Math.sqrt(nx * nx + ny * ny + nz * nz);
      if (nl > 1e-12) {
        const inv = 1 / nl;
        nx *= inv; ny *= inv; nz *= inv;
      } else {
        nx = 0; ny = 0; nz = 1;
      }

      /* ---- local film thickness ---- */
      let t = T_MEAN + gravity * (tGrad[idx] - T_MEAN);
      t += defectAmp * defectField[idx];
      t *= scale;
      if (t < 1e-12) t = 1e-12;

      let Xs = 0, Ys = 0, Zs = 0;
      let visible = false;

      /* ---- light 1 ---- */
      if (on1) {
        let d = nx * ld1x + ny * ld1y + nz * ld1z;
        if (d >= 0) {
          if (d > 1) d = 1;
          const sinI = Math.sqrt(1 - d * d);
          let sinT = sinI / N_FILM;
          if (sinT > 1) sinT = 1;
          const cosT = Math.sqrt(1 - sinT * sinT);
          const opd  = 2 * N_FILM * t * cosT;

          let k = Math.round(opd * 1e9);
          if (k < 0) k = 0; else if (k > TABLE_MAX) k = TABLE_MAX;

          Xs += tableXYZ[k * 3];
          Ys += tableXYZ[k * 3 + 1];
          Zs += tableXYZ[k * 3 + 2];
          visible = true;
        }
      }

      /* ---- light 2 ---- */
      if (on2) {
        let d = nx * ld2x + ny * ld2y + nz * ld2z;
        if (d >= 0) {
          if (d > 1) d = 1;
          const sinI = Math.sqrt(1 - d * d);
          let sinT = sinI / N_FILM;
          if (sinT > 1) sinT = 1;
          const cosT = Math.sqrt(1 - sinT * sinT);
          const opd  = 2 * N_FILM * t * cosT;

          let k = Math.round(opd * 1e9);
          if (k < 0) k = 0; else if (k > TABLE_MAX) k = TABLE_MAX;

          Xs += tableXYZ[k * 3];
          Ys += tableXYZ[k * 3 + 1];
          Zs += tableXYZ[k * 3 + 2];
          visible = true;
        }
      }

      xyzScratch[idx * 3]     = Xs;
      xyzScratch[idx * 3 + 1] = Ys;
      xyzScratch[idx * 3 + 2] = Zs;

      alphaArr[idx] = visible ? 1.0 : 0.0;
    }
  }

  /* ---------- global normalization ---------- */
  let maxVal = 0;
  for (let n = 0; n < numVerts; n++) {
    const a = xyzScratch[n * 3];
    const b = xyzScratch[n * 3 + 1];
    const c = xyzScratch[n * 3 + 2];
    if (a > maxVal) maxVal = a;
    if (b > maxVal) maxVal = b;
    if (c > maxVal) maxVal = c;
  }

  const normScale = (maxVal > 1e-12) ? (0.95 / maxVal) : 0;

  /* ---------- XYZ -> sRGB ---------- */
  if (normScale > 0) {
    for (let n = 0; n < numVerts; n++) {
      const o = n * 3;
      const X = xyzScratch[o]     * normScale;
      const Y = xyzScratch[o + 1] * normScale;
      const Z = xyzScratch[o + 2] * normScale;
      xyzToSrgb(X, Y, Z, colArr, o);
    }
  } else {
    for (let n = 0; n < numVerts; n++) {
      const o = n * 3;
      colArr[o] = 0.5; colArr[o + 1] = 0.5; colArr[o + 2] = 0.5;
    }
  }

  /* ---------- flag GPU uploads ---------- */
  bubbleGeo.attributes.position.needsUpdate = true;
  bubbleGeo.attributes.aColor.needsUpdate   = true;
  bubbleGeo.attributes.aAlpha.needsUpdate   = true;

  /* ---------- helpers ---------- */
  rebuildContours(h);
  rebuildArrows(theta1, theta2, on1, on2);

  /* ---------- info text ---------- */
  const tMinCur = (T_MEAN + gravity * (T_MIN0 - T_MEAN)) * scale;
  const tMaxCur = (T_MEAN + gravity * (T_MAX0 - T_MEAN)) * scale;
  document.getElementById('info-thick').textContent =
    `${(tMinCur * 1e9).toFixed(1)} – ${(tMaxCur * 1e9).toFixed(1)} nm`;
  document.getElementById('info-defect').textContent = `${defectNm} nm`;
}

/* ==================================================================
   UI WIRING
   ================================================================== */
let pending = false;
function requestUpdate() {
  if (pending) return;
  pending = true;
  requestAnimationFrame(() => {
    pending = false;
    updateScene();
  });
}

function bindSlider(id, valId, key, fmt) {
  const el  = document.getElementById(id);
  const out = document.getElementById(valId);
  const apply = () => {
    const v = parseFloat(el.value);
    state[key] = v;
    out.textContent = fmt(v);
    requestUpdate();
  };
  el.addEventListener('input', apply);
  out.textContent = fmt(parseFloat(el.value));
}

bindSlider('s-theta1',  'v-theta1',  'theta1',  v => v.toFixed(0));
bindSlider('s-theta2',  'v-theta2',  'theta2',  v => v.toFixed(0));
bindSlider('s-scale',   'v-scale',   'scale',   v => v.toFixed(2));
bindSlider('s-height',  'v-height',  'height',  v => v.toFixed(2));
bindSlider('s-gravity', 'v-gravity', 'gravity', v => v.toFixed(2));
bindSlider('s-defect',  'v-defect',  'defect',  v => v.toFixed(0));

document.getElementById('c-l1').addEventListener('change', e => {
  state.on1 = e.target.checked;
  requestUpdate();
});
document.getElementById('c-l2').addEventListener('change', e => {
  state.on2 = e.target.checked;
  requestUpdate();
});

/* ==================================================================
   RESIZE
   ================================================================== */
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* ==================================================================
   RENDER LOOP
   ================================================================== */
function animate() {
  requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}

/* ==================================================================
   INITIAL DRAW
   ================================================================== */
updateScene();
animate();
</script>
</body>
</html>
