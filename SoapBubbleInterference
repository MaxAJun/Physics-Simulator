/* ---- Bubble mesh material ---- */
const bubbleMat = new THREE.ShaderMaterial({
  vertexShader: `
    attribute vec3  aColor;
    attribute float aAlpha;
    varying   vec3  vColor;
    varying   float vAlpha;
    void main() {
