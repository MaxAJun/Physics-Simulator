/* ---- Resample CMF to 1 nm (380..780 nm, 401 samples) ---- */
const LAM_MIN  = 380;
const N_LAM    = 401;
const D_LAMBDA = 1e-9;

const cmfX = new Float64Array(N_LAM);
const cmfY = new Float64Array(N_LAM);
const cmfZ = new Float64Array(N_LAM);

(function resampleCMF() {
  const step = 5;
  for (let i = 0; i < N_LAM; i++) {
    const lam = LAM_MIN + i;
    const t  = (lam - 380) / step;
    let i0 = Math.floor(t);
    if (i0 < 0) i0 = 0;
    if (i0 > CMF_DATA.length - 2) i0 = CMF_DATA.length - 2;
    const f = t - i0;
    const a = CMF_DATA[i0], b = CMF_DATA[i0 + 1];
    cmfX[i] = a[1] * (1 - f) + b[1] * f;
    cmfY[i] = a[2] * (1 - f) + b[2] * f;
    cmfZ[i] = a[3] * (1 - f) + b[3] * f;
  }
})();

/* ==================================================================
   OPD -> XYZ LOOKUP TABLE
   sin^2(pi*OPD/lambda) = 0.5 - 0.5*cos(2*pi*OPD/lambda)
   Table resolution: 1 nm, range 0..12800 nm
   ================================================================== */
const TABLE_MAX = 12800;
const tableXYZ  = new Float32Array((TABLE_MAX + 1) * 3);

(function buildLookupTable() {
  const lambdas = new Float64Array(N_LAM);
  for (let i = 0; i < N_LAM; i++) lambdas[i] = (LAM_MIN + i) * 1e-9;

  const twoPi = 2 * Math.PI;
  for (let k = 0; k <= TABLE_MAX; k++) {
    const opd = k * 1e-9;
    let X = 0, Y = 0, Z = 0;
    for (let i = 0; i < N_LAM; i++) {
      const I = 0.5 - 0.5 * Math.cos(twoPi * opd / lambdas[i]);
      X += I * cmfX[i];
      Y += I * cmfY[i];
      Z += I * cmfZ[i];
    }
    tableXYZ[k * 3]     = X * D_LAMBDA;
    tableXYZ[k * 3 + 1] = Y * D_LAMBDA;
    tableXYZ[k * 3 + 2] = Z * D_LAMBDA;
  }
})();

/* ==================================================================
   SPHERE / ELLIPSOID MESH
   ================================================================== */
const numVerts = N_U * N_V;

const uArr = new Float64Array(N_U);
const vArr = new Float64Array(N_V);
for (let i = 0; i < N_U; i++) uArr[i] = (i / (N_U - 1)) * 2 * Math.PI;
for (let j = 0; j < N_V; j++) vArr[j] = (j / (N_V - 1)) * (Math.PI / 2);

const Xb    = new Float32Array(numVerts);
const Yb    = new Float32Array(numVerts);
const Zb    = new Float32Array(numVerts);
const tGrad = new Float32Array(numVerts);

const posArr   = new Float32Array(numVerts * 3);
const colArr   = new Float32Array(numVerts * 3);
const alphaArr = new Float32Array(numVerts);

for (let j = 0; j < N_V; j++) {
  const v  = vArr[j];
  const sv = Math.sin(v);
  const cv = Math.cos(v);
  for (let i = 0; i < N_U; i++) {
    const idx = j * N_U + i;
    const u   = uArr[i];
    Xb[idx] = sv * Math.cos(u);
    Yb[idx] = sv * Math.sin(u);
    Zb[idx] = cv;
    tGrad[idx] = T_MIN0 + (T_MAX0 - T_MIN0) * sv;

    posArr[idx * 3]     = Xb[idx];
    posArr[idx * 3 + 1] = Yb[idx];
    posArr[idx * 3 + 2] = cv;
  }
}

/* ---- Triangle indices ---- */
const idxArr = new Uint32Array((N_U - 1) * (N_V - 1) * 6);
let ii = 0;
for (let j = 0; j < N_V - 1; j++) {
  for (let i = 0; i < N_U - 1; i++) {
    const a = j * N_U + i;
    const b = a + 1;
    const c = a + N_U;
    const d = c + 1;
    idxArr[ii++] = a; idxArr[ii++] = c; idxArr[ii++] = b;
    idxArr[ii++] = b; idxArr[ii++] = c; idxArr[ii++] = d;
  }
}

/* ==================================================================
   SMOOTH RANDOM DEFECT FIELD  (low-frequency wave superposition)
   ================================================================== */
function mulberry32(a) {
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function generateSmoothDefect(nv, nu, seed) {
  const rng = mulberry32(seed);
  const d   = new Float32Array(nv * nu);

  const nWaves = 26;
  for (let w = 0; w < nWaves; w++) {
    const kx  = Math.floor(rng() * 6) + 1;
    const ky  = Math.floor(rng() * 4) + 1;
    const phx = rng() * Math.PI * 2;
    const phy = rng() * Math.PI * 2;
    const amp = 1.0 / (kx * kx + ky * ky + 1);

    for (let j = 0; j < nv; j++) {
      const v  = (j / (nv - 1)) * (Math.PI / 2);
      const sy = Math.sin(ky * v + phy);
      for (let i = 0; i < nu; i++) {
        const u = (i / (nu - 1)) * Math.PI * 2;
        d[j * nu + i] += amp * Math.sin(kx * u + phx) * sy;
      }
    }
  }

  let mx = 0;
  for (let k = 0; k < d.length; k++) {
    const a = Math.abs(d[k]);
    if (a > mx) mx = a;
  }
  if (mx > 1e-12) {
    for (let k = 0; k < d.length; k++) d[k] /= mx;
  }
  return d;
}

const defectField = generateSmoothDefect(N_V, N_U, 42);

/* ==================================================================
   COLOR / XYZ -> sRGB HELPERS
   ================================================================== */
function cctfEncode(c) {
  if (c <= 0.0031308) {
    const v = c * 12.92;
    return v < 0 ? 0 : v;
  }
  const v = 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
  return v > 1 ? 1 : v;
}

function xyzToSrgb(X, Y, Z, out, o) {
  const r =  3.2404542 * X - 1.5371385 * Y - 0.4985314 * Z;
  const g = -0.9692660 * X + 1.8760108 * Y + 0.0415560 * Z;
  const b =  0.0556434 * X - 0.2040259 * Y + 1.0572252 * Z;
  out[o]     = cctfEncode(r);
  out[o + 1] = cctfEncode(g);
  out[o + 2] = cctfEncode(b);
}

/* ==================================================================
