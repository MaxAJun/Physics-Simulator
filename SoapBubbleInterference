/* ==================================================================
   PHYSICAL PARAMETERS
   ================================================================== */
const N_FILM   = 1.33;
const T_MIN0   = 50e-9;
const T_MAX0   = 2000e-9;
const R_SPHERE = 1.0;
const N_U      = 180;
const N_V      = 90;
const T_MEAN   = (T_MIN0 + T_MAX0) / 2;

/* ==================================================================
   CIE 1931 2-DEGREE STANDARD OBSERVER  (5 nm intervals, 380..780 nm)
   [ wavelength, xbar, ybar, zbar ]
   ================================================================== */
const CMF_DATA = [
